{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:exakt:schema:input-manifest-v1",
  "title": "Exakt input manifest v1",
  "description": "Exact tracked, dirty, and untracked source inputs with closed regular, symlink, LFS, and submodule representations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "repository_id",
    "source_revision",
    "regular_files",
    "symlinks",
    "lfs_objects",
    "submodules",
    "deleted_files",
    "inclusion_rules",
    "exclusions"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "input-manifest-v1"},
    "manifest_id": {"$ref": "#/$defs/non_empty_string"},
    "repository_id": {"$ref": "#/$defs/non_empty_string"},
    "source_revision": {"$ref": "#/$defs/source_revision"},
    "regular_files": {
      "type": "array",
      "items": {"$ref": "#/$defs/regular_file"},
      "uniqueItems": true
    },
    "symlinks": {
      "type": "array",
      "items": {"$ref": "#/$defs/symlink"},
      "uniqueItems": true
    },
    "lfs_objects": {
      "type": "array",
      "items": {"$ref": "#/$defs/lfs_object"},
      "uniqueItems": true
    },
    "submodules": {
      "type": "array",
      "items": {"$ref": "#/$defs/submodule"},
      "uniqueItems": true
    },
    "deleted_files": {
      "type": "array",
      "items": {"$ref": "#/$defs/deleted_file"},
      "uniqueItems": true
    },
    "inclusion_rules": {"$ref": "#/$defs/inclusion_rules"},
    "exclusions": {
      "type": "array",
      "items": {"$ref": "#/$defs/exclusion"},
      "uniqueItems": true
    }
  },
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "string_list": {
      "type": "array",
      "items": {"$ref": "#/$defs/non_empty_string"},
      "uniqueItems": true
    },
    "provenance": {
      "type": "string",
      "enum": ["tracked", "dirty", "untracked"]
    },
    "source_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": {"type": ["string", "null"]},
        "tree": {"type": ["string", "null"]}
      }
    },
    "regular_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "provenance", "content_digest", "size"],
      "properties": {
        "path": {"$ref": "#/$defs/non_empty_string"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "content_digest": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0}
      }
    },
    "symlink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "provenance", "link_target", "link_target_digest"],
      "properties": {
        "path": {"$ref": "#/$defs/non_empty_string"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "link_target": {"type": "string"},
        "link_target_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "lfs_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "provenance",
        "pointer_digest",
        "pointer_size",
        "materialized_object_digest",
        "materialized_size"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/non_empty_string"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "pointer_digest": {"$ref": "#/$defs/sha256"},
        "pointer_size": {"type": "integer", "minimum": 0},
        "materialized_object_digest": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "materialized_size": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "submodule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "provenance",
        "repository_id",
        "pinned_commit",
        "dirty_manifest_digest"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/non_empty_string"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "repository_id": {"$ref": "#/$defs/non_empty_string"},
        "pinned_commit": {"$ref": "#/$defs/non_empty_string"},
        "dirty_manifest_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "deleted_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "provenance", "base_digest"],
      "properties": {
        "path": {"$ref": "#/$defs/non_empty_string"},
        "provenance": {"type": "string", "const": "dirty"},
        "base_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "inclusion_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included_classes", "excluded_classes", "explicitly_included_paths"],
      "properties": {
        "included_classes": {"$ref": "#/$defs/string_list"},
        "excluded_classes": {"$ref": "#/$defs/string_list"},
        "explicitly_included_paths": {"$ref": "#/$defs/string_list"}
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": {"$ref": "#/$defs/non_empty_string"},
        "reason": {"$ref": "#/$defs/non_empty_string"}
      }
    }
  }
}
