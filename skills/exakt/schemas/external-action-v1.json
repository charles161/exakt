{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:exakt:schema:external-action-v1",
  "title": "Exakt external action v1",
  "description": "Approval-bound external action intent and durable transition observations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action_id",
    "work_item_id",
    "action_digest",
    "action_class",
    "target",
    "approval_id",
    "state",
    "idempotency_key",
    "provider_id",
    "expires_at",
    "nonce",
    "transitions"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "external-action-v1"},
    "action_id": {"$ref": "#/$defs/non_empty_string"},
    "work_item_id": {"$ref": "#/$defs/non_empty_string"},
    "action_digest": {"$ref": "#/$defs/sha256"},
    "action_class": {"$ref": "#/$defs/side_effect_class"},
    "target": {"$ref": "#/$defs/non_empty_string"},
    "approval_id": {"type": ["string", "null"]},
    "state": {"$ref": "#/$defs/external_action_state"},
    "idempotency_key": {"$ref": "#/$defs/non_empty_string"},
    "provider_id": {"type": ["string", "null"]},
    "expires_at": {"$ref": "#/$defs/non_empty_string"},
    "nonce": {"$ref": "#/$defs/non_empty_string"},
    "transitions": {
      "type": "array",
      "items": {"$ref": "#/$defs/transition"},
      "minItems": 1
    }
  },
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "side_effect_class": {
      "type": "string",
      "enum": [
        "local_read",
        "network_read",
        "local_reversible_write",
        "external_reversible_write",
        "external_irreversible_write",
        "publication",
        "production_deploy"
      ]
    },
    "external_action_state": {
      "type": "string",
      "enum": ["planned", "approved", "intent_persisted", "send_started", "confirmed", "unknown", "failed"]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "timestamp", "evidence_id"],
      "properties": {
        "state": {"$ref": "#/$defs/external_action_state"},
        "timestamp": {"$ref": "#/$defs/non_empty_string"},
        "evidence_id": {"type": ["string", "null"]}
      }
    }
  }
}
