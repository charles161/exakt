{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:exakt:schema:verification-bundle-v1",
  "title": "Exakt verification bundle v1",
  "description": "Immutable subject/provenance graph and proof-contract selection for a verifier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "work_item_id",
    "oracle_digest",
    "input_manifest_digest",
    "created_at",
    "subject_graph",
    "proof_contract_refs"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "verification-bundle-v1"},
    "bundle_id": {"$ref": "#/$defs/non_empty_string"},
    "work_item_id": {"$ref": "#/$defs/non_empty_string"},
    "oracle_digest": {"$ref": "#/$defs/sha256"},
    "input_manifest_digest": {"$ref": "#/$defs/sha256"},
    "created_at": {"$ref": "#/$defs/non_empty_string"},
    "subject_graph": {"$ref": "#/$defs/subject_graph"},
    "proof_contract_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/proof_contract_ref"},
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "non_empty_string_list": {
      "type": "array",
      "items": {"$ref": "#/$defs/non_empty_string"},
      "minItems": 1,
      "uniqueItems": true
    },
    "proof_contract_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_contract_id", "proof_contract_digest", "claim_ids"],
      "properties": {
        "proof_contract_id": {"$ref": "#/$defs/non_empty_string"},
        "proof_contract_digest": {"$ref": "#/$defs/sha256"},
        "claim_ids": {"$ref": "#/$defs/non_empty_string_list"}
      }
    },
    "subject_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "kind", "identity", "subject_digest", "capture_method", "applicability_window", "locator"],
      "properties": {
        "subject_id": {"$ref": "#/$defs/non_empty_string"},
        "kind": {"type": "string", "enum": ["source", "artifact", "deployment", "database", "provider_receipt", "external_observation", "composite"]},
        "identity": {"$ref": "#/$defs/non_empty_string"},
        "subject_digest": {"$ref": "#/$defs/sha256"},
        "capture_method": {"$ref": "#/$defs/non_empty_string"},
        "applicability_window": {"$ref": "#/$defs/applicability_window"},
        "locator": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "applicability_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starts_at", "expires_at"],
      "properties": {
        "starts_at": {"$ref": "#/$defs/non_empty_string"},
        "expires_at": {"type": ["string", "null"]}
      }
    },
    "subject_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_subject_id", "to_subject_id", "relation"],
      "properties": {
        "from_subject_id": {"$ref": "#/$defs/non_empty_string"},
        "to_subject_id": {"$ref": "#/$defs/non_empty_string"},
        "relation": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "subject_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {"$ref": "#/$defs/subject_node"},
          "minItems": 1,
          "uniqueItems": true
        },
        "edges": {
          "type": "array",
          "items": {"$ref": "#/$defs/subject_edge"},
          "uniqueItems": true
        }
      }
    }
  }
}
