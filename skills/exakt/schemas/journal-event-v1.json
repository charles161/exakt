{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:exakt:schema:journal-event-v1",
  "title": "Exakt journal event v1",
  "description": "Portable event metadata and an immutable payload reference; replay semantics are implemented in a later task.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "work_item_id",
    "sequence",
    "actor",
    "timestamp",
    "idempotency_key",
    "previous_record_hash",
    "prior_state_root",
    "workflow_phase",
    "run_status",
    "payload"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "journal-event-v1"},
    "event_id": {"$ref": "#/$defs/non_empty_string"},
    "event_type": {"$ref": "#/$defs/non_empty_string"},
    "work_item_id": {"$ref": "#/$defs/non_empty_string"},
    "sequence": {"type": "integer", "minimum": 1},
    "actor": {"$ref": "#/$defs/non_empty_string"},
    "timestamp": {"$ref": "#/$defs/non_empty_string"},
    "idempotency_key": {"$ref": "#/$defs/non_empty_string"},
    "previous_record_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "prior_state_root": {"$ref": "#/$defs/sha256"},
    "workflow_phase": {"$ref": "#/$defs/workflow_phase"},
    "run_status": {"$ref": "#/$defs/run_status"},
    "payload": {"$ref": "#/$defs/payload_reference"}
  },
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "workflow_phase": {
      "type": "string",
      "enum": ["intake", "recon", "requirements", "design", "plan", "execute", "verify", "handoff"]
    },
    "run_status": {
      "type": "string",
      "enum": ["active", "suspended", "cancelled"]
    },
    "payload_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "payload_hash"],
      "properties": {
        "object_id": {"$ref": "#/$defs/non_empty_string"},
        "payload_hash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
