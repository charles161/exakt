{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forge:schema:forge-feedback-v1",
  "title": "Forge feedback proposal v1",
  "description": "Untrusted structured feedback proposals; this envelope never grants approval by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feedback_id",
    "work_item_id",
    "expected_state_root",
    "target_ids",
    "proposals",
    "submitted_by"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "forge-feedback-v1"},
    "feedback_id": {"$ref": "#/$defs/non_empty_string"},
    "work_item_id": {"$ref": "#/$defs/non_empty_string"},
    "expected_state_root": {"$ref": "#/$defs/sha256"},
    "target_ids": {"$ref": "#/$defs/non_empty_string_list"},
    "proposals": {
      "type": "array",
      "items": {"$ref": "#/$defs/proposal"},
      "minItems": 1,
      "uniqueItems": true
    },
    "submitted_by": {"$ref": "#/$defs/submitted_by"}
  },
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "non_empty_string_list": {
      "type": "array",
      "items": {"$ref": "#/$defs/non_empty_string"},
      "minItems": 1,
      "uniqueItems": true
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_path", "operation", "value_json"],
      "properties": {
        "field_path": {"$ref": "#/$defs/non_empty_string"},
        "operation": {"type": "string", "enum": ["add", "replace", "remove"]},
        "value_json": {"type": "string"}
      }
    },
    "submitted_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "channel"],
      "properties": {
        "kind": {"type": "string", "enum": ["user", "agent", "tool"]},
        "identity": {"$ref": "#/$defs/non_empty_string"},
        "channel": {"$ref": "#/$defs/non_empty_string"}
      }
    }
  }
}
