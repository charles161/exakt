{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forge:schema:agent-envelope-v1",
  "title": "Forge agent output envelope v1",
  "description": "A specialist proposal with scoped inputs, explicit unknowns, evidence links, patch lease data, and typed outputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_id",
    "work_item_id",
    "agent_run_id",
    "role",
    "input_bundle_digest",
    "status",
    "assumptions",
    "unknowns",
    "source_refs",
    "findings",
    "patch",
    "outputs",
    "created_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "agent-envelope-v1"},
    "envelope_id": {"$ref": "#/$defs/non_empty_string"},
    "work_item_id": {"$ref": "#/$defs/non_empty_string"},
    "agent_run_id": {"$ref": "#/$defs/non_empty_string"},
    "role": {"$ref": "#/$defs/non_empty_string"},
    "input_bundle_digest": {"$ref": "#/$defs/sha256"},
    "status": {"type": "string", "enum": ["proposal", "completed", "blocked", "failed"]},
    "assumptions": {"$ref": "#/$defs/string_list"},
    "unknowns": {"$ref": "#/$defs/string_list"},
    "source_refs": {"$ref": "#/$defs/string_list"},
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"},
      "uniqueItems": true
    },
    "patch": {"$ref": "#/$defs/patch"},
    "outputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/output"},
      "uniqueItems": true
    },
    "created_at": {"$ref": "#/$defs/non_empty_string"}
  },
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "string_list": {
      "type": "array",
      "items": {"$ref": "#/$defs/non_empty_string"},
      "uniqueItems": true
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "claim", "evidence_ids", "counterevidence_ids"],
      "properties": {
        "finding_id": {"$ref": "#/$defs/non_empty_string"},
        "claim": {"$ref": "#/$defs/non_empty_string"},
        "evidence_ids": {"$ref": "#/$defs/string_list"},
        "counterevidence_ids": {"$ref": "#/$defs/string_list"}
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_subject_digest", "path_lease_ids", "digest"],
      "properties": {
        "base_subject_digest": {"$ref": "#/$defs/sha256"},
        "path_lease_ids": {"$ref": "#/$defs/string_list"},
        "digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}(?![\\s\\S])"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "object_digest"],
      "properties": {
        "schema_id": {"$ref": "#/$defs/non_empty_string"},
        "object_digest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
